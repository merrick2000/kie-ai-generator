# ── Database ─────────────────────────────────────────────────────────────────
# Required. Highfield stores accounts and articles in Postgres.
# For local development:  docker compose -f docker-compose.dev.yml up -d
DATABASE_URL=postgres://postgres:postgres@localhost:5432/highfield

# TLS follows the `sslmode` in the URL above, and is OFF when absent.
#
#   Postgres on a private network (Docker, Dokploy):  leave it out
#   Managed provider (Neon, Supabase, RDS):           ?sslmode=require
#
# A container Postgres speaks no TLS, so forcing it there fails with
# "The server does not support SSL connections".
#
# Set this only to override the URL when you cannot edit it:
#   require | verify-full | disable
DATABASE_SSL=

# ── Secrets ───────────────────────────────────────────────────────────────────
# Encrypts stored Kie.ai API keys with AES-256-GCM. One is generated and kept
# in the database if you leave this blank, but setting it explicitly is better:
# it can be rotated, and it keeps the secret out of the store it protects.
#   openssl rand -base64 32
APP_SECRET=

# ── Access ────────────────────────────────────────────────────────────────────
# Set to false on a deployed instance so only people you invite can register.
# The very first account is always allowed, otherwise a closed instance could
# never be set up. Existing users can always sign in.
SIGNUPS_ENABLED=

# ── Kie.ai ────────────────────────────────────────────────────────────────────
# All optional. Each user connects their own key from inside the app.

# Fallback key used only when a user has not set their own. Leave blank for a
# pure bring-your-own-key instance. Get one at https://kie.ai/api-key
KIE_API_KEY=

# Verifies incoming webhook callbacks. Found alongside your API key on kie.ai.
KIE_WEBHOOK_HMAC_KEY=

# Public origin of this instance, for example https://studio.example.com
#
# Set this in production. It is the canonical answer to "where does this app
# live", used for the article URL returned to the publisher, the sitemap,
# robots.txt and the callBackUrl sent to Kie.ai.
#
# Without it those URLs are reconstructed from the proxy headers, which works
# but cannot know the public domain when it differs from the host the
# container is addressed by. Kie callbacks are skipped entirely, and the
# studio falls back to polling, which works everywhere.
NEXT_PUBLIC_APP_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error. Defaults to debug in development and info in
# production. Development prints aligned colour output; production prints one
# JSON line per event, for a log collector to index.
LOG_LEVEL=

# pretty | json. Defaults to pretty, which is what a plain-text log panel such
# as Dokploy or `docker logs` can actually display. Use json only when the logs
# are shipped to a collector that indexes fields, such as Loki or Datadog.
LOG_FORMAT=

# ── Blog webhook ──────────────────────────────────────────────────────────────
# Shared signing secret from the publishing service. The endpoint at
# /api/webhooks/articles refuses every delivery until this is set, because it
# writes HTML that is then served to every visitor.
ARTICLE_WEBHOOK_SECRET=

# Optional second factor. When set, deliveries must also carry
# `Authorization: Bearer <token>`.
ARTICLE_WEBHOOK_TOKEN=
